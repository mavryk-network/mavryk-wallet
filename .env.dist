TEMPLE_WALLET_API_URL=YOUR_VALUE

# urls
NODES_URL=YOUR_VALUE
EXTERNAL_API=YOUR_VALUE

REDUX_DEVTOOLS_PORT=8000

# Admin private key (B-CRYPT-1): intentionally NOT listed here, so it is no longer a "required"
# env var and is never baked into the shipped bundle by webpack DefinePlugin (a listed key with
# a value becomes a plaintext literal in the store build, extractable by anyone). The Pro/KYC
# signing it powered must move SERVER-SIDE. For local TESTNET-only work you MAY set
# SUPER_ADMIN_PRIVATE_KEY in your own .env.local (now optional, never a mainnet key); it must
# NOT be injected into production builds. See .claude/plans/repo-audit-2026-06.md.
KYC_CONTRACT=YOUR_VALUE

COINGECKO_API_KEY=YOUR_VALUE
COINGECKO_API=YOUR_VALUE

# Optional. Overrides the dApp-facing extension ID used in local builds.
# PRODUCTION_EXTENSION_ID=your-extension-id
