TEMPLE_WALLET_API_URL=YOUR_VALUE

# urls
NODES_URL=YOUR_VALUE
EXTERNAL_API=YOUR_VALUE

# Optional. Set ENABLE_REDUX_DEVTOOLS=true and run `yarn temp` to connect remote Redux DevTools.
# ENABLE_REDUX_DEVTOOLS=false
# REDUX_DEVTOOLS_PORT=8000

# Optional. Basenet-only test registrar signer for development and production builds.
# Embedded publicly in the extension bundle. Never use a Mainnet or production/admin key.
# TESTNET_KYC_SIGNER_PRIVATE_KEY=YOUR_VALUE
KYC_CONTRACT=YOUR_VALUE

COINGECKO_API_KEY=YOUR_VALUE
COINGECKO_API=YOUR_VALUE

# Optional. Overrides the dApp-facing extension ID used in local builds.
# PRODUCTION_EXTENSION_ID=your-extension-id
